# Copy to test.env; paths in secret configuration resolve beside macos-signing.env.
INFINITY_DESKTOP_APP_ID=com.infinityagent.desktop
INFINITY_DESKTOP_AUTO_UPDATE_ENV=test
INFINITY_DESKTOP_MANDATORY_UPDATE_TEST_ORIGIN=
INFINITY_DESKTOP_MANDATORY_UPDATE_CONFIG='{"allowedAuthOrigins":["https://login.example.com"]}'
DOWNLOAD_TEST_ORIGIN=
# Generate a 32-character lowercase hexadecimal release ID; retain it for upgrade testing.
DOWNLOAD_TEST_RELEASE_ID=
INFINITY_DESKTOP_MACOS_PACK_CONCURRENCY=4
INFINITY_DESKTOP_MACOS_ZIP_COMPRESSION_LEVEL=3
INFINITY_DESKTOP_MACOS_DOWNLOAD_PROXY=
# Temporarily changes the active network service's system HTTP/HTTPS proxies.
INFINITY_DESKTOP_MACOS_NOTARIZATION_PROXY=
# Optional absolute private directory; setup fills this in for machine presets. Omit to use checkout-local storage.
# INFINITY_DESKTOP_MACOS_SIGNATURE_CACHE_DIR=
