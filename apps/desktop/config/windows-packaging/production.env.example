# Copy to production.env in the same machine configuration directory and fill in the values.
INFINITY_DESKTOP_APP_ID=com.infinityagent.desktop
INFINITY_DESKTOP_AUTO_UPDATE_ENV=production
INFINITY_DESKTOP_MANDATORY_UPDATE_PROD_ORIGIN=
INFINITY_DESKTOP_MANDATORY_UPDATE_CONFIG='{}'
# INFINITY_DESKTOP_WINDOWS_SIGNATURE_CACHE_DIR=
INFINITY_DESKTOP_WINDOWS_SIGNATURE_CACHE_CONCURRENCY=4
# Installer archive compression (0-9).
INFINITY_DESKTOP_WINDOWS_COMPRESSION_LEVEL=3
