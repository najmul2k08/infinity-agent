# Copy to windows-signing.env in the same machine configuration directory and fill in the values.
# Restrict this file to the runner account, SYSTEM and administrators.
# File paths resolve relative to this file; use the same account as local signing.
INFINITY_DESKTOP_WINDOWS_CER_FILE=../certificates/windows.cer
INFINITY_DESKTOP_WINDOWS_SIGNTOOL=
INFINITY_DESKTOP_WINDOWS_KEY_CONTAINER=
INFINITY_DESKTOP_WINDOWS_TOKEN_PIN=
