# Harness home; profiles, sessions, and credentials live here.
INFINITY_HOME=/data/.infinity-agent

# Listener. The shipped web profile rejects wildcard addresses by design.
INFINITY_WEB_HOST=127.0.0.1
INFINITY_WEB_PORT=3080

# External leg. Set both to the tunnel hostname browsers dial.
INFINITY_PUBLIC_URL=https://example.trycloudflare.com/
INFINITY_TRUSTED_HOST=example.trycloudflare.com

# Model gateway. Matches the provider block in cordis.patch.yml.example.
GATEWAY_BASE_URL=https://gateway.example/v1
GATEWAY_API_KEY=
