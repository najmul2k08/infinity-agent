  },
  "peerDependencies": {
    "@infinity-agent/cordis": "workspace:~",
    "@infinity-agent/agent": "workspace:*",
    "@infinity-agent/attachment": "workspace:*",
    "@infinity-agent/llm": "workspace:*",
    "@infinity-agent/mcp-client": "workspace:*",
    "@infinity-agent/session": "workspace:*",
    "@infinity-agent/session-persistence": "workspace:*",
    "@infinity-agent/token-meter": "workspace:*",
    "@infinity-agent/user-approval": "workspace:*"
  },
