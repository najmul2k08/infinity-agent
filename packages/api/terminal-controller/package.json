{
  "name": "@infinity-agent/api-terminal-controller",
  "description": "Session-owned interactive terminals with shell discovery, screen recovery and typed Remote control",
  "version": "0.2.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/najmul2k08/infinity-agent.git",
    "directory": "packages/api/terminal-controller"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@infinity-agent/api-gateway"
      ],
      "external": [
        "@infinity-agent/api-gateway/client"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "dependencies": {
    "@infinity-agent/deque": "workspace:*",
    "@infinity-agent/lazy-require": "workspace:*",
    "@infinity-agent/typert-protocol": "workspace:*",
    "@infinity-agent/util-values": "workspace:*",
    "@infinity-agent/schemastery": "workspace:~",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/headless": "^6.0.0",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@infinity-agent/subprocess": "workspace:*",
    "@infinity-agent/cordis": "workspace:~"
  },
  "devDependencies": {
    "@infinity-agent/cordis": "workspace:~",
    "@infinity-agent/agent": "workspace:*",
    "@infinity-agent/api-gateway": "workspace:*",
    "@infinity-agent/brand": "workspace:*",
    "@infinity-agent/client-connection": "workspace:*",
    "@infinity-agent/client-store": "workspace:*",
    "@infinity-agent/fs": "workspace:*",
    "@infinity-agent/remote-mock": "workspace:*",
    "@infinity-agent/sandbox": "workspace:*",
    "@infinity-agent/sandbox-policy": "workspace:*",
    "@infinity-agent/session": "workspace:*",
    "@infinity-agent/session-projection": "workspace:*",
    "@infinity-agent/subprocess": "workspace:*",
    "@infinity-agent/subprocess-local": "workspace:*",
    "@infinity-agent/util-crypto": "workspace:*",
    "@infinity-agent/working-directory": "workspace:*"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ]
}
