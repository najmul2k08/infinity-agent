{
  "name": "@infinity-agent/plugin-market",
  "description": "Configured plugin market indexes for the Web Discover page and the plugin_market agent tool",
  "version": "0.2.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/najmul2k08/infinity-agent.git",
    "directory": "packages/boot/plugin-market"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./tools": {
      "types": "./lib/types/tools.d.ts",
      "default": "./lib/types/tools.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/worker.cjs",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@infinity-agent/app-boot": "workspace:*",
    "@infinity-agent/atomic-write": "workspace:*",
    "@infinity-agent/brand": "workspace:*",
    "@infinity-agent/package-manifest": "workspace:*",
    "@infinity-agent/plugin-detail": "workspace:*",
    "@infinity-agent/plugin-market-index": "workspace:*",
    "@infinity-agent/timeout": "workspace:*",
    "@infinity-agent/util-values": "workspace:*",
    "@infinity-agent/schemastery": "workspace:~",
    "execa": "^10.0.1",
    "hosted-git-info": "^9.0.3",
    "minisearch": "^7.2.0",
    "semver": "^7.8.5",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@infinity-agent/cordis": "workspace:~",
    "@infinity-agent/cordis-plugin-loader": "workspace:~",
    "@infinity-agent/plugin-manager": "workspace:*",
    "@infinity-agent/settings": "workspace:*",
    "@infinity-agent/subprocess": "workspace:*",
    "@infinity-agent/tools": "workspace:*",
    "@infinity-agent/typert-protocol": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@infinity-agent/settings": {
      "optional": true
    }
  },
  "devDependencies": {
    "@infinity-agent/cordis": "workspace:~",
    "@infinity-agent/cordis-plugin-loader": "workspace:~",
    "@infinity-agent/cosmokit": "workspace:~",
    "@infinity-agent/app-boot": "workspace:*",
    "@infinity-agent/client-connection": "workspace:*",
    "@infinity-agent/config-editor": "workspace:*",
    "@infinity-agent/llm": "workspace:*",
    "@infinity-agent/plugin-manager": "workspace:*",
    "@infinity-agent/settings": "workspace:*",
    "@infinity-agent/subprocess": "workspace:*",
    "@infinity-agent/system-prompt": "workspace:*",
    "@infinity-agent/tool-executor-native": "workspace:*",
    "@infinity-agent/tool-testkit": "workspace:*",
    "@infinity-agent/tools": "workspace:*",
    "@infinity-agent/typert-protocol": "workspace:*",
    "@types/hosted-git-info": "^3.0.5",
    "@types/semver": "^7.8.0"
  }
}
