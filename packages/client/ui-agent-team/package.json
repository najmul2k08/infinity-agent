{
  "name": "@infinity-agent/client-ui-agent-team",
  "description": "Web shared task board for a subagent tree",
  "version": "0.2.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/najmul2k08/infinity-agent.git",
    "directory": "packages/client/ui-agent-team"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@infinity-agent/api-session-controller",
        "@infinity-agent/client-locale",
        "@infinity-agent/client-ui-conversation",
        "@infinity-agent/client-ui-chat",
        "@infinity-agent/client-ui-layout",
        "@infinity-agent/client-ui-primitives"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@infinity-agent/cordis": "workspace:~"
  },
  "devDependencies": {
    "@infinity-agent/api-session-controller": "workspace:*",
    "@infinity-agent/client-locale": "workspace:*",
    "@infinity-agent/client-store": "workspace:*",
    "@infinity-agent/client-test-runtime": "workspace:*",
    "@infinity-agent/commands": "workspace:*",
    "@infinity-agent/client-ui-conversation": "workspace:*",
    "@infinity-agent/client-ui-chat": "workspace:*",
    "@infinity-agent/util-values": "workspace:*",
    "@infinity-agent/client-ui-primitives": "workspace:*",
    "@infinity-agent/client-ui-renderer": "workspace:*",
    "@infinity-agent/client-ui-slots": "workspace:*",
    "@infinity-agent/agent-team": "workspace:*",
    "@infinity-agent/session": "workspace:*",
    "@testing-library/react": "^16.3.3",
    "@infinity-agent/cordis": "workspace:~",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@infinity-agent/client-ui-model-selection": "workspace:*",
    "@infinity-agent/client-ui-layout": "workspace:*",
    "@infinity-agent/api-remotes": "workspace:*",
    "@infinity-agent/client-ui-subagent": "workspace:*",
    "@infinity-agent/agent": "workspace:*"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
