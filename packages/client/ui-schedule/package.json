{
  "name": "@infinity-agent/client-ui-schedule",
  "description": "Host task management page and Session reminder catalog",
  "version": "0.2.2-rc.1",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@infinity-agent/api-remotes",
        "@infinity-agent/api-session-controller",
        "@infinity-agent/api-workspace-controller",
        "@infinity-agent/client-connection",
        "@infinity-agent/client-locale",
        "@infinity-agent/client-ui-conversation",
        "@infinity-agent/client-ui-layout",
        "@infinity-agent/client-ui-sidebar",
        "@infinity-agent/client-ui-sidebar-right",
        "@infinity-agent/client-ui-tool",
        "@infinity-agent/client-ui-workspace",
        "@infinity-agent/client-ui-primitives"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/najmul2k08/infinity-agent.git",
    "directory": "packages/client/ui-schedule"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@infinity-agent/cordis": "workspace:~"
  },
  "devDependencies": {
    "@infinity-agent/api-remote-access": "workspace:*",
    "@infinity-agent/api-remotes": "workspace:*",
    "@infinity-agent/api-session-controller": "workspace:*",
    "@infinity-agent/api-workspace-controller": "workspace:*",
    "@infinity-agent/client-connection": "workspace:*",
    "@infinity-agent/client-locale": "workspace:*",
    "@infinity-agent/client-store": "workspace:*",
    "@infinity-agent/client-test-runtime": "workspace:*",
    "@infinity-agent/client-ui-conversation": "workspace:*",
    "@infinity-agent/client-ui-layout": "workspace:*",
    "@infinity-agent/client-ui-primitives": "workspace:*",
    "@infinity-agent/client-ui-renderer": "workspace:*",
    "@infinity-agent/client-ui-session": "workspace:*",
    "@infinity-agent/client-ui-sidebar": "workspace:*",
    "@infinity-agent/client-ui-sidebar-right": "workspace:*",
    "@infinity-agent/client-ui-slots": "workspace:*",
    "@infinity-agent/client-ui-tool": "workspace:*",
    "@infinity-agent/client-ui-workspace": "workspace:*",
    "@infinity-agent/schedule": "workspace:*",
    "@infinity-agent/session": "workspace:*",
    "@infinity-agent/util-time": "workspace:*",
    "@infinity-agent/util-values": "workspace:*",
    "@testing-library/react": "^16.3.3",
    "clsx": "^2.1.1",
    "@infinity-agent/cordis": "workspace:~",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
