{
  "name": "@infinity-agent/client-ui-tool",
  "description": "Client Tool call-tree renderer and keyed per-tool presentation slot",
  "version": "0.2.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/najmul2k08/infinity-agent.git",
    "directory": "packages/client/ui-tool"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@infinity-agent/api-workspace-controller",
        "@infinity-agent/client-connection",
        "@infinity-agent/client-locale",
        "@infinity-agent/client-ui-conversation",
        "@infinity-agent/api-session-controller"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@infinity-agent/cordis": "workspace:~"
  },
  "devDependencies": {
    "@infinity-agent/spill-policy": "workspace:*",
    "@infinity-agent/fs-patch": "workspace:*",
    "@infinity-agent/agent": "workspace:*",
    "@infinity-agent/llm": "workspace:*",
    "@infinity-agent/session": "workspace:*",
    "@infinity-agent/system-prompt": "workspace:*",
    "@infinity-agent/tool-testkit": "workspace:*",
    "@infinity-agent/tools": "workspace:*",
    "@infinity-agent/tool-executor-native": "workspace:*",
    "@infinity-agent/tool-executor-ptc": "workspace:*",
    "@infinity-agent/tool-jobs": "workspace:*",
    "@infinity-agent/tool-session-query": "workspace:*",
    "@infinity-agent/tool-terminal": "workspace:*",
    "@infinity-agent/spill": "workspace:*",
    "@infinity-agent/cordis": "workspace:~",
    "@infinity-agent/api-remotes": "workspace:*",
    "@infinity-agent/client-connection": "workspace:*",
    "@infinity-agent/client-locale": "workspace:*",
    "@infinity-agent/client-test-runtime": "workspace:*",
    "@infinity-agent/client-ui-conversation": "workspace:*",
    "@infinity-agent/client-ui-primitives": "workspace:*",
    "@infinity-agent/client-ui-slots": "workspace:*",
    "@testing-library/react": "^16.3.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@infinity-agent/api-workspace-controller": "workspace:*",
    "@infinity-agent/client-ui-chat": "workspace:*",
    "@infinity-agent/client-ui-renderer": "workspace:*",
    "@infinity-agent/client-ui-session": "workspace:*",
    "@infinity-agent/util-values": "workspace:*",
    "@infinity-agent/util-workspace-path": "workspace:*",
    "@infinity-agent/attachment": "workspace:*",
    "clsx": "^2.0.0",
    "@infinity-agent/ptc-runtime": "workspace:*",
    "@infinity-agent/token-meter": "workspace:*",
    "@infinity-agent/user-questions": "workspace:*",
    "@infinity-agent/client-ui-context-menu": "workspace:*",
    "@infinity-agent/api-session-controller": "workspace:*"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
