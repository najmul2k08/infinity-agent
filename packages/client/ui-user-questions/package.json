{
  "name": "@infinity-agent/client-ui-user-questions",
  "description": "Web ask_user_question composer takeover and plan-review presentation UI",
  "version": "0.2.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/najmul2k08/infinity-agent.git",
    "directory": "packages/client/ui-user-questions"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@infinity-agent/api-remotes",
        "@infinity-agent/api-session-controller",
        "@infinity-agent/client-locale",
        "@infinity-agent/client-ui-conversation",
        "@infinity-agent/client-ui-renderer",
        "@infinity-agent/client-ui-session",
        "@infinity-agent/client-ui-chat"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@infinity-agent/cordis": "workspace:~"
  },
  "devDependencies": {
    "@infinity-agent/cordis": "workspace:~",
    "@infinity-agent/agent": "workspace:*",
    "@infinity-agent/api-remotes": "workspace:*",
    "@infinity-agent/api-session-controller": "workspace:*",
    "@infinity-agent/brand": "workspace:*",
    "@infinity-agent/client-locale": "workspace:*",
    "@infinity-agent/client-store": "workspace:*",
    "@infinity-agent/system-prompt": "workspace:*",
    "@infinity-agent/tool-executor-native": "workspace:*",
    "@infinity-agent/tools": "workspace:*",
    "@infinity-agent/user-questions": "workspace:*",
    "@infinity-agent/client-ui-primitives": "workspace:*",
    "@infinity-agent/client-ui-slots": "workspace:*",
    "@infinity-agent/client-ui-renderer": "workspace:*",
    "@infinity-agent/client-ui-session": "workspace:*",
    "@infinity-agent/typert-protocol": "workspace:*",
    "react": "^18.2.0",
    "@infinity-agent/client-ui-conversation": "workspace:*",
    "@infinity-agent/client-connection": "workspace:*",
    "@infinity-agent/session": "workspace:*",
    "clsx": "^2.0.0",
    "@infinity-agent/llm": "workspace:*",
    "@infinity-agent/client-ui-chat": "workspace:*",
    "@infinity-agent/client-ui-tool": "workspace:*",
    "@infinity-agent/tool-executor-ptc": "workspace:*"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
