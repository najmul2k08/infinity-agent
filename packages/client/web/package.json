{
  "name": "@infinity-agent/client-web",
  "description": "Web boot kernel: static module table, Cordis loader, framework-free boot page, and UI-renderer handoff",
  "version": "0.2.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/najmul2k08/infinity-agent.git",
    "directory": "packages/client/web"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./injections": {
      "types": "./lib/types/apply-injections.d.ts",
      "default": "./lib/apply-injections.js"
    }
  },
  "license": "MIT",
  "devDependencies": {
    "@infinity-agent/cordis-plugin-loader": "workspace:~",
    "@infinity-agent/client-modules": "workspace:*",
    "@infinity-agent/client-store": "workspace:*",
    "@infinity-agent/client-ui-dockkit": "workspace:*",
    "@infinity-agent/client-ui-renderer": "workspace:*",
    "@infinity-agent/client-ui-primitives": "workspace:*",
    "@infinity-agent/client-ui-slots": "workspace:*",
    "@infinity-agent/cordis": "workspace:~",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^6.0.3",
    "@infinity-agent/host-webserver": "workspace:*",
    "zod": "4.4.3",
    "@tanstack/react-virtual": "3.14.10"
  },
  "peerDependencies": {
    "@infinity-agent/cordis": "workspace:~"
  },
  "files": [
    "lib/index.js",
    "lib/**/*.css",
    "lib/apply-injections.js",
    "lib/types/**/*.d.ts"
  ]
}
