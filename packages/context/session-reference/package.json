{
  "name": "@infinity-agent/session-reference",
  "description": "Cross-session snapshot references and durable untrusted model context (ctx.sessionReferenceResolver)",
  "version": "0.2.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/najmul2k08/infinity-agent.git",
    "directory": "packages/context/session-reference"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@infinity-agent/brand": "workspace:*",
    "@infinity-agent/util-values": "workspace:*",
    "@infinity-agent/schemastery": "workspace:~",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@infinity-agent/cordis": "workspace:~",
    "@infinity-agent/agent": "workspace:*",
    "@infinity-agent/compaction": "workspace:*",
    "@infinity-agent/llm": "workspace:*",
    "@infinity-agent/output-retention": "workspace:*",
    "@infinity-agent/session": "workspace:*",
    "@infinity-agent/session-projection": "workspace:*",
    "@infinity-agent/session-projection-cache": "workspace:*",
    "@infinity-agent/session-query": "workspace:*",
    "@infinity-agent/session-title": "workspace:*",
    "@infinity-agent/spill": "workspace:*",
    "@infinity-agent/subagent": "workspace:*",
    "@infinity-agent/system-prompt": "workspace:*",
    "@infinity-agent/typert-protocol": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@infinity-agent/spill": {
      "optional": true
    },
    "@infinity-agent/session-projection-cache": {
      "optional": true
    }
  },
  "devDependencies": {
    "@infinity-agent/cordis": "workspace:~",
    "@infinity-agent/cordis-plugin-include": "workspace:~",
    "@infinity-agent/cordis-plugin-loader": "workspace:~",
    "@infinity-agent/agent": "workspace:*",
    "@infinity-agent/compaction": "workspace:*",
    "@infinity-agent/fs-local": "workspace:*",
    "@infinity-agent/llm": "workspace:*",
    "@infinity-agent/output-retention": "workspace:*",
    "@infinity-agent/session": "workspace:*",
    "@infinity-agent/session-projection": "workspace:*",
    "@infinity-agent/session-projection-cache": "workspace:*",
    "@infinity-agent/session-query": "workspace:*",
    "@infinity-agent/session-query-sqlite": "workspace:*",
    "@infinity-agent/session-title": "workspace:*",
    "@infinity-agent/spill": "workspace:*",
    "@infinity-agent/subagent": "workspace:*",
    "@infinity-agent/spill-local": "workspace:*",
    "@infinity-agent/system-prompt": "workspace:*",
    "@infinity-agent/tool-executor-native": "workspace:*",
    "@infinity-agent/tool-fs": "workspace:*",
    "@infinity-agent/tool-testkit": "workspace:*",
    "@infinity-agent/tools": "workspace:*",
    "@infinity-agent/typert-protocol": "workspace:*",
    "@infinity-agent/working-directory": "workspace:*"
  }
}
