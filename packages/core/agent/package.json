{
  "name": "@infinity-agent/agent",
  "description": "Agent interface, registry, initiator scope, and event vocabulary for the Infinity agent",
  "version": "0.2.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/najmul2k08/infinity-agent.git",
    "directory": "packages/core/agent"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@infinity-agent/llm": "workspace:*",
    "@infinity-agent/scope": "workspace:*",
    "@infinity-agent/session": "workspace:*",
    "@infinity-agent/session-projection": "workspace:*",
    "@infinity-agent/system-prompt": "workspace:*",
    "@infinity-agent/typert-protocol": "workspace:*",
    "@infinity-agent/util-values": "workspace:*",
    "@infinity-agent/workspace": "workspace:*",
    "@infinity-agent/cordis": "workspace:~"
  },
  "peerDependenciesMeta": {
    "@infinity-agent/workspace": {
      "optional": true
    }
  },
  "devDependencies": {
    "@infinity-agent/llm": "workspace:*",
    "@infinity-agent/scope": "workspace:*",
    "@infinity-agent/session": "workspace:*",
    "@infinity-agent/session-projection": "workspace:*",
    "@infinity-agent/system-prompt": "workspace:*",
    "@infinity-agent/typert-protocol": "workspace:*",
    "@infinity-agent/typert-registry": "workspace:*",
    "@infinity-agent/util-values": "workspace:*",
    "@infinity-agent/workspace": "workspace:*",
    "@infinity-agent/cordis": "workspace:~"
  },
  "dependencies": {
    "@infinity-agent/brand": "workspace:*",
    "zod": "4.4.3"
  }
}
