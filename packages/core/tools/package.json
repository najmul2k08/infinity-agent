{
  "name": "@infinity-agent/tools",
  "description": "Tool registry and execution pipeline for the Infinity agent",
  "version": "0.2.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/najmul2k08/infinity-agent.git",
    "directory": "packages/core/tools"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./presentation": {
      "types": "./lib/types/presentation.d.ts",
      "default": "./lib/types/presentation.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./pipeline": {
      "types": "./lib/types/pipeline.d.ts",
      "default": "./lib/pipeline.js"
    }
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/pipeline.js",
    "lib/shared-*.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@infinity-agent/cordis": "workspace:~",
    "@infinity-agent/agent": "workspace:*",
    "@infinity-agent/llm": "workspace:*",
    "@infinity-agent/scope": "workspace:*",
    "@infinity-agent/session": "workspace:*",
    "@infinity-agent/system-prompt": "workspace:*",
    "@infinity-agent/user-approval": "workspace:*"
  },
  "dependencies": {
    "@infinity-agent/brand": "workspace:*",
    "@infinity-agent/util-values": "workspace:*",
    "@infinity-agent/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@infinity-agent/cordis": "workspace:~",
    "@infinity-agent/agent": "workspace:*",
    "@infinity-agent/llm": "workspace:*",
    "@infinity-agent/scope": "workspace:*",
    "@infinity-agent/session": "workspace:*",
    "@infinity-agent/session-projection": "workspace:*",
    "@infinity-agent/system-prompt": "workspace:*",
    "@infinity-agent/tool-executor-native": "workspace:*",
    "@infinity-agent/tool-testkit": "workspace:*",
    "@infinity-agent/user-approval": "workspace:*",
    "@infinity-agent/agent-loop-testkit": "workspace:*"
  }
}
