{
  "name": "@infinity-agent/credentials-local",
  "description": "File-backed credentials provider ($INFINITY_HOME/.env under the live process environment) for the Infinity agent",
  "version": "0.2.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/najmul2k08/infinity-agent.git",
    "directory": "packages/credentials/credentials-local"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@infinity-agent/atomic-write": "workspace:*",
    "@infinity-agent/credentials": "workspace:*",
    "@infinity-agent/launch-environment": "workspace:*",
    "@infinity-agent/home-paths": "workspace:*",
    "@infinity-agent/cordis": "workspace:~"
  },
  "dependencies": {
    "chokidar": "5.0.0",
    "@infinity-agent/schemastery": "workspace:~",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@infinity-agent/atomic-write": "workspace:*",
    "@infinity-agent/credentials": "workspace:*",
    "@infinity-agent/launch-environment": "workspace:*",
    "@infinity-agent/home-paths": "workspace:*",
    "@infinity-agent/cordis": "workspace:~"
  }
}
