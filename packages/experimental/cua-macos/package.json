{
  "name": "@infinity-agent/experimental-cua-macos",
  "description": "macOS native provider for shared Computer Use application and window objects",
  "version": "0.2.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/najmul2k08/infinity-agent.git",
    "directory": "packages/experimental/cua-macos"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "native/bin",
    "cua-helper.json",
    "native/Package.swift",
    "native/Info.plist",
    "native/DSHComputerUse.icns",
    "native/build_app.py",
    "native/Sources",
    "native/tests/swift",
    "native/tests/test_swift.py",
    "native/LICENSE.cua-driver",
    "native/LICENSE.computer-use-icon",
    "native/upstream.json",
    "native/README.md",
    "native/README.zh.md",
    "native/protocol.schema.json",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@infinity-agent/cordis": "workspace:~",
    "@infinity-agent/computer-use": "workspace:*",
    "@infinity-agent/system-prompt": "workspace:*",
    "@infinity-agent/tools": "workspace:*",
    "@infinity-agent/agent": "workspace:*",
    "@infinity-agent/subprocess": "workspace:*",
    "@infinity-agent/user-questions": "workspace:*"
  },
  "dependencies": {
    "@infinity-agent/schemastery": "workspace:~",
    "zod": "^4.4.3",
    "@infinity-agent/atomic-write": "workspace:*",
    "@infinity-agent/cua": "workspace:*"
  },
  "devDependencies": {
    "@infinity-agent/working-directory": "workspace:*",
    "@infinity-agent/cordis": "workspace:~",
    "@infinity-agent/cordis-plugin-include": "workspace:~",
    "@infinity-agent/cordis-plugin-loader": "workspace:~",
    "@infinity-agent/agent": "workspace:*",
    "@infinity-agent/agent-loop": "workspace:*",
    "@infinity-agent/agent-loop-testkit": "workspace:*",
    "@infinity-agent/attachment": "workspace:*",
    "@infinity-agent/attachment-local": "workspace:*",
    "@infinity-agent/computer-use": "workspace:*",
    "@infinity-agent/llm": "workspace:*",
    "@infinity-agent/session": "workspace:*",
    "@infinity-agent/session-projection": "workspace:*",
    "@infinity-agent/system-prompt": "workspace:*",
    "@infinity-agent/tool-executor-native": "workspace:*",
    "@infinity-agent/tool-executor-ptc": "workspace:*",
    "@infinity-agent/tool-testkit": "workspace:*",
    "@infinity-agent/tools": "workspace:*",
    "@infinity-agent/subprocess": "workspace:*",
    "@infinity-agent/subprocess-local": "workspace:*",
    "@infinity-agent/fs-local": "workspace:*",
    "@infinity-agent/llm-deepseek": "workspace:*",
    "@infinity-agent/ptc-runtime-node": "workspace:*",
    "@infinity-agent/sandbox-local": "workspace:*",
    "@infinity-agent/sandbox-policy": "workspace:*",
    "sharp": "^0.35.3",
    "@infinity-agent/ptc-runtime": "workspace:*",
    "@infinity-agent/user-questions": "workspace:*",
    "@infinity-agent/settings": "workspace:*",
    "@infinity-agent/app-boot": "workspace:*",
    "@infinity-agent/config-editor": "workspace:*",
    "@infinity-agent/hmr": "workspace:*",
    "@infinity-agent/cordis-plugin-timer": "workspace:~",
    "@infinity-agent/storage": "workspace:*",
    "@infinity-agent/storage-json": "workspace:*",
    "@infinity-agent/storage-domain": "workspace:*"
  },
  "scripts": {
    "build:native": "xcrun python3 native/build_app.py",
    "build:icon": "node native/generate_icon.mjs"
  },
  "os": [
    "darwin"
  ]
}
