{
  "name": "@infinity-agent/personalized-recommendations",
  "description": "Personalized pages and built-in plugin recommendations offered as cards below answers",
  "version": "0.2.2-rc.1",
  "icon": "./icon.svg",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/najmul2k08/infinity-agent.git",
    "directory": "packages/experimental/personalized-recommendations"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "icon.svg",
    "locale/*.json",
    "docs",
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@infinity-agent/action-cards": "workspace:*",
    "@infinity-agent/client-ui-action-cards": "workspace:*",
    "@infinity-agent/creation-recommendations": "workspace:*",
    "@infinity-agent/client-ui-creation-recommendations": "workspace:*",
    "@infinity-agent/plugin-recommendations": "workspace:*",
    "@infinity-agent/client-ui-plugin-recommendations": "workspace:*"
  },
  "peerDependencies": {
    "@infinity-agent/cordis": "workspace:~"
  },
  "devDependencies": {
    "@infinity-agent/cordis": "workspace:~",
    "@infinity-agent/cordis-plugin-include": "workspace:~",
    "js-yaml": "^4.3.2",
    "@infinity-agent/cordis-plugin-timer": "workspace:~",
    "@infinity-agent/agent": "workspace:*",
    "@infinity-agent/api-remote-access": "workspace:*",
    "@infinity-agent/app-boot": "workspace:*",
    "@infinity-agent/hmr": "workspace:*",
    "@infinity-agent/llm": "workspace:*",
    "@infinity-agent/plugin-manager": "workspace:*",
    "@infinity-agent/session": "workspace:*",
    "@infinity-agent/session-projection": "workspace:*",
    "@infinity-agent/skill": "workspace:*",
    "@infinity-agent/system-prompt": "workspace:*",
    "@infinity-agent/tool-executor-native": "workspace:*",
    "@infinity-agent/tools": "workspace:*"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
