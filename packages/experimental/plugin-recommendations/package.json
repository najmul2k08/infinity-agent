{
  "name": "@infinity-agent/plugin-recommendations",
  "description": "Official plugin suggestions with explicit user activation and persistent conversation decisions",
  "version": "0.2.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/najmul2k08/infinity-agent.git",
    "directory": "packages/experimental/plugin-recommendations"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./skills/*.md": "./skills/*.md"
  },
  "license": "MIT",
  "peerDependencies": {
    "@infinity-agent/cordis": "workspace:~",
    "@infinity-agent/typert-protocol": "workspace:*",
    "@infinity-agent/llm": "workspace:*",
    "@infinity-agent/skill": "workspace:*"
  },
  "devDependencies": {
    "@infinity-agent/cordis": "workspace:~",
    "@infinity-agent/typert-protocol": "workspace:*",
    "@infinity-agent/llm": "workspace:*",
    "@infinity-agent/agent": "workspace:*",
    "@infinity-agent/session": "workspace:*",
    "@infinity-agent/plugin-manager": "workspace:*",
    "@infinity-agent/package-manifest": "workspace:*",
    "@infinity-agent/api-remote-access": "workspace:*",
    "@infinity-agent/skill": "workspace:*"
  },
  "dependencies": {
    "zod": "4.4.3",
    "@infinity-agent/client-ui-plugin-recommendations": "workspace:*",
    "@infinity-agent/action-cards": "workspace:*",
    "@infinity-agent/client-ui-action-cards": "workspace:*"
  },
  "files": [
    "icon.svg",
    "locale/*.json",
    "lib/index.js",
    "skills/*.md",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "icon": "./icon.svg"
}
