    "@infinity-agent/subprocess-local": "workspace:*",
    "@infinity-agent/llm": "workspace:*",
    "@infinity-agent/output-retention": "workspace:*",
    "@infinity-agent/session": "workspace:*",
    "@infinity-agent/spill": "workspace:*",
