{
  "name": "@infinity-agent/goal",
  "description": "Event-sourced same-session goal state and lifecycle service for the Infinity agent",
  "version": "0.2.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/najmul2k08/infinity-agent.git",
    "directory": "packages/goal/goal"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./client": {
      "types": "./lib/types/client.d.ts",
      "default": "./lib/types/client.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@infinity-agent/agent": "workspace:*",
    "@infinity-agent/session-projection": "workspace:*",
    "@infinity-agent/brand": "workspace:*",
    "@infinity-agent/llm": "workspace:*",
    "@infinity-agent/scope": "workspace:*",
    "@infinity-agent/session": "workspace:*",
    "@infinity-agent/typert-protocol": "workspace:*",
    "@infinity-agent/cordis": "workspace:~"
  },
  "dependencies": {
    "@infinity-agent/schemastery": "workspace:~",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@infinity-agent/agent": "workspace:*",
    "@infinity-agent/agent-loop": "workspace:*",
    "@infinity-agent/agent-loop-testkit": "workspace:*",
    "@infinity-agent/bash-local": "workspace:*",
    "@infinity-agent/session-projection": "workspace:*",
    "@infinity-agent/brand": "workspace:*",
    "@infinity-agent/llm": "workspace:*",
    "@infinity-agent/loader-smoke": "workspace:*",
    "@infinity-agent/scope": "workspace:*",
    "@infinity-agent/session": "workspace:*",
    "@infinity-agent/session-checkpoint-policy": "workspace:*",
    "@infinity-agent/session-persistence-jsonl": "workspace:*",
    "@infinity-agent/subprocess-local": "workspace:*",
    "@infinity-agent/typert-protocol": "workspace:*",
    "@infinity-agent/cordis": "workspace:~"
  }
}
