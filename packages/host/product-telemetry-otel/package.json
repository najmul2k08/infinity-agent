{
  "name": "@infinity-agent/host-product-telemetry-otel",
  "description": "Explicit product usage events exported through OpenTelemetry HTTP logs",
  "version": "0.2.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/najmul2k08/infinity-agent.git",
    "directory": "packages/host/product-telemetry-otel"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@infinity-agent/schemastery": "workspace:~",
    "@opentelemetry/api-logs": "0.222.0",
    "@opentelemetry/otlp-exporter-base": "0.222.0",
    "@opentelemetry/sdk-logs": "0.222.0"
  },
  "peerDependencies": {
    "@infinity-agent/cordis": "workspace:~",
    "@infinity-agent/otel": "workspace:*"
  },
  "devDependencies": {
    "@infinity-agent/cordis": "workspace:~",
    "@infinity-agent/cordis-plugin-loader": "workspace:~",
    "@infinity-agent/app-boot": "workspace:*",
    "@infinity-agent/loader-smoke": "workspace:*",
    "@infinity-agent/otel": "workspace:*"
  }
}
