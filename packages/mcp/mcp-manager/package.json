{
  "name": "@infinity-agent/mcp-manager",
  "description": "MCP server manager: a settings-driven fleet of mcp-client instances with runtime status, restart, and probe",
  "version": "0.2.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/najmul2k08/infinity-agent.git",
    "directory": "packages/mcp/mcp-manager"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@infinity-agent/mcp-client": "workspace:*",
    "@infinity-agent/tools": "workspace:*",
    "@infinity-agent/util-values": "workspace:*",
    "@infinity-agent/cordis": "workspace:~",
    "@infinity-agent/cordis-plugin-loader": "workspace:~",
    "@infinity-agent/typert-protocol": "workspace:*"
  },
  "dependencies": {
    "@infinity-agent/timeout": "workspace:*",
    "@infinity-agent/schemastery": "workspace:~",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.2.0",
    "@infinity-agent/credentials": "workspace:*",
    "@infinity-agent/mcp-client": "workspace:*",
    "@infinity-agent/settings": "workspace:*",
    "@infinity-agent/system-prompt": "workspace:*",
    "@infinity-agent/tools": "workspace:*",
    "@infinity-agent/util-values": "workspace:*",
    "@infinity-agent/cordis": "workspace:~",
    "@infinity-agent/app-boot": "workspace:*",
    "@infinity-agent/config-editor": "workspace:*",
    "@infinity-agent/hmr": "workspace:*",
    "@infinity-agent/cordis-plugin-loader": "workspace:~",
    "@infinity-agent/cordis-plugin-timer": "workspace:~",
    "@infinity-agent/typert-protocol": "workspace:*"
  }
}
