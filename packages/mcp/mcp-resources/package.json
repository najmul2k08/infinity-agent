{
  "name": "@infinity-agent/mcp-resources",
  "description": "Scoped MCP resource discovery and reading through shared model tools",
  "version": "0.2.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/najmul2k08/infinity-agent.git",
    "directory": "packages/mcp/mcp-resources"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@infinity-agent/cordis": "workspace:~",
    "@infinity-agent/llm": "workspace:*",
    "@infinity-agent/scope": "workspace:*",
    "@infinity-agent/system-prompt": "workspace:*",
    "@infinity-agent/tools": "workspace:*"
  },
  "devDependencies": {
    "@infinity-agent/cordis": "workspace:~",
    "@infinity-agent/llm": "workspace:*",
    "@infinity-agent/ptc-runtime": "workspace:*",
    "@infinity-agent/scope": "workspace:*",
    "@infinity-agent/tool-executor-native": "workspace:*",
    "@infinity-agent/tool-executor-ptc": "workspace:*",
    "@infinity-agent/tool-testkit": "workspace:*",
    "@infinity-agent/tools": "workspace:*",
    "@infinity-agent/system-prompt": "workspace:*",
    "@infinity-agent/agent": "workspace:*"
  },
  "dependencies": {
    "@infinity-agent/util-values": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@infinity-agent/system-prompt": {
      "optional": true
    }
  }
}
