{
  "name": "@infinity-agent/schedule",
  "description": "Host-wide durable reminders with shared management and delivery to existing or new Sessions",
  "version": "0.2.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/najmul2k08/infinity-agent.git",
    "directory": "packages/schedule/schedule"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client.d.ts",
      "default": "./lib/types/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    }
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@infinity-agent/agent": "workspace:*",
    "@infinity-agent/api-session-controller": "workspace:*",
    "@infinity-agent/brand": "workspace:*",
    "@infinity-agent/llm": "workspace:*",
    "@infinity-agent/session": "workspace:*",
    "@infinity-agent/session-persistence": "workspace:*",
    "@infinity-agent/session-projection": "workspace:*",
    "@infinity-agent/storage-domain": "workspace:*",
    "@infinity-agent/subagent": "workspace:*",
    "@infinity-agent/tools": "workspace:*",
    "@infinity-agent/typert-protocol": "workspace:*",
    "@infinity-agent/util-time": "workspace:*",
    "@infinity-agent/workspace": "workspace:*",
    "@infinity-agent/cordis": "workspace:~"
  },
  "dependencies": {
    "@infinity-agent/schemastery": "workspace:~",
    "@js-temporal/polyfill": "0.5.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@infinity-agent/cordis-plugin-loader": "workspace:~",
    "@infinity-agent/agent": "workspace:*",
    "@infinity-agent/agent-loop": "workspace:*",
    "@infinity-agent/agent-loop-testkit": "workspace:*",
    "@infinity-agent/api-session-controller": "workspace:*",
    "@infinity-agent/brand": "workspace:*",
    "@infinity-agent/llm": "workspace:*",
    "@infinity-agent/session": "workspace:*",
    "@infinity-agent/session-persistence": "workspace:*",
    "@infinity-agent/session-persistence-jsonl": "workspace:*",
    "@infinity-agent/session-projection": "workspace:*",
    "@infinity-agent/session-title": "workspace:*",
    "@infinity-agent/storage": "workspace:*",
    "@infinity-agent/storage-domain": "workspace:*",
    "@infinity-agent/storage-json": "workspace:*",
    "@infinity-agent/subagent": "workspace:*",
    "@infinity-agent/system-prompt": "workspace:*",
    "@infinity-agent/tool-executor-native": "workspace:*",
    "@infinity-agent/tools": "workspace:*",
    "@infinity-agent/typert-protocol": "workspace:*",
    "@infinity-agent/util-time": "workspace:*",
    "@infinity-agent/workspace": "workspace:*",
    "@infinity-agent/cordis": "workspace:~",
    "@infinity-agent/goal": "workspace:*",
    "@infinity-agent/goal-round-driver": "workspace:*"
  }
}
