{
  "name": "@infinity-agent/subagent-codex",
  "description": "One-shot Codex subagent provider over the official app-server protocol",
  "version": "0.2.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/najmul2k08/infinity-agent.git",
    "directory": "packages/subagent/subagent-codex"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "icon.svg",
    "locale/*.json",
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@infinity-agent/cordis": "workspace:~",
    "@infinity-agent/llm": "workspace:*",
    "@infinity-agent/session": "workspace:*",
    "@infinity-agent/subagent": "workspace:*",
    "@infinity-agent/subprocess": "workspace:*",
    "@infinity-agent/timeout": "workspace:*"
  },
  "dependencies": {
    "@infinity-agent/brand": "workspace:*",
    "@infinity-agent/sdk-protocol": "workspace:*",
    "@infinity-agent/schemastery": "workspace:~",
    "@openai/codex": "0.153.4",
    "@infinity-agent/tool-subagent": "workspace:*"
  },
  "devDependencies": {
    "@infinity-agent/cordis": "workspace:~",
    "@infinity-agent/cordis-plugin-loader": "workspace:~",
    "@infinity-agent/agent": "workspace:*",
    "@infinity-agent/app-boot": "workspace:*",
    "@infinity-agent/llm": "workspace:*",
    "@infinity-agent/loader-smoke": "workspace:*",
    "@infinity-agent/session": "workspace:*",
    "@infinity-agent/session-checkpoint-policy": "workspace:*",
    "@infinity-agent/session-persistence-jsonl": "workspace:*",
    "@infinity-agent/session-projection": "workspace:*",
    "@infinity-agent/subagent": "workspace:*",
    "@infinity-agent/subprocess": "workspace:*",
    "@infinity-agent/subprocess-local": "workspace:*",
    "@infinity-agent/timeout": "workspace:*",
    "@infinity-agent/tool-jobs": "workspace:*",
    "@infinity-agent/tools": "workspace:*"
  },
  "icon": "./icon.svg"
}
