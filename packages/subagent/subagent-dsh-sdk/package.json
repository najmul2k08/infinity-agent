    "directory": "packages/subagent/subagent-dsh-sdk"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@infinity-agent/cordis": "workspace:~",
    "@infinity-agent/agent": "workspace:*",
    "@infinity-agent/llm": "workspace:*",
    "@infinity-agent/sdk-client": "workspace:*",
    "@infinity-agent/session": "workspace:*",
    "@infinity-agent/subagent": "workspace:*",
    "@infinity-agent/subprocess": "workspace:*"
  },
  "dependencies": {
    "@infinity-agent/brand": "workspace:*",
    "@infinity-agent/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@infinity-agent/cordis": "workspace:~",
    "@infinity-agent/cordis-plugin-loader": "workspace:~",
    "@infinity-agent/agent": "workspace:*",
    "@infinity-agent/agent-instructions": "workspace:*",
    "@infinity-agent/app-boot": "workspace:*",
    "@infinity-agent/llm": "workspace:*",
    "@infinity-agent/llm-deepseek": "workspace:*",
    "@infinity-agent/llm-deepseek-api-key": "workspace:*",
    "@infinity-agent/loader-smoke": "workspace:*",
    "@infinity-agent/sdk-client": "workspace:*",
    "@infinity-agent/sdk-protocol": "workspace:*",
    "@infinity-agent/session": "workspace:*",
    "@infinity-agent/session-checkpoint-policy": "workspace:*",
    "@infinity-agent/session-persistence-jsonl": "workspace:*",
    "@infinity-agent/session-projection": "workspace:*",
    "@infinity-agent/skill-filesystem": "workspace:*",
    "@infinity-agent/subagent": "workspace:*",
    "@infinity-agent/subprocess": "workspace:*",
    "@infinity-agent/system-prompt": "workspace:*",
    "@infinity-agent/tool-subagent": "workspace:*"
  }
