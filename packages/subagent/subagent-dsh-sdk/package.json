{
  "name": "@infinity-agent/subagent-dsh-sdk",
  "description": "Out-of-process SDK subagent backend: drives a child Infinity agent runtime subprocess over stdio JSON-RPC through the TypeScript SDK client",
  "version": "0.2.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
