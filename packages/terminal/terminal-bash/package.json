{
  "name": "@infinity-agent/terminal-bash",
  "description": "Persistent shell PTY backend over the Infinity agent subprocess terminal primitive",
  "version": "0.2.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/najmul2k08/infinity-agent.git",
    "directory": "packages/terminal/terminal-bash"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@infinity-agent/agent": "workspace:*",
    "@infinity-agent/terminal": "workspace:*",
    "@infinity-agent/sandbox": "workspace:*",
    "@infinity-agent/sandbox-policy": "workspace:*",
    "@infinity-agent/session": "workspace:*",
    "@infinity-agent/subprocess": "workspace:*",
    "@infinity-agent/cordis": "workspace:~",
    "@infinity-agent/working-directory": "workspace:*"
  },
  "dependencies": {
    "@infinity-agent/lazy-require": "workspace:*",
    "@infinity-agent/pwsh-local": "workspace:*",
    "@infinity-agent/schemastery": "workspace:~",
    "@xterm/headless": "^6.0.0"
  },
  "devDependencies": {
    "@infinity-agent/agent": "workspace:*",
    "@infinity-agent/agent-loop-testkit": "workspace:*",
    "@infinity-agent/terminal": "workspace:*",
    "@infinity-agent/sandbox": "workspace:*",
    "@infinity-agent/sandbox-policy": "workspace:*",
    "@infinity-agent/session": "workspace:*",
    "@infinity-agent/session-projection": "workspace:*",
    "@infinity-agent/subprocess": "workspace:*",
    "@infinity-agent/subprocess-local": "workspace:*",
    "@infinity-agent/cordis": "workspace:~",
    "@infinity-agent/working-directory": "workspace:*"
  }
}
