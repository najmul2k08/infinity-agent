{
  "name": "@infinity-agent/web-search-deepseek",
  "description": "DeepSeek-backed search provider (native web_search via the Anthropic-compatible API) for the Infinity agent web capability seam (ctx.web)",
  "version": "0.2.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/najmul2k08/infinity-agent.git",
    "directory": "packages/web/web-search-deepseek"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@infinity-agent/agent": "workspace:*",
    "@infinity-agent/credentials": "workspace:*",
    "@infinity-agent/deepseek-account": "workspace:*",
    "@infinity-agent/launch-environment": "workspace:*",
    "@infinity-agent/llm-deepseek": "workspace:*",
    "@infinity-agent/session": "workspace:*",
    "@infinity-agent/web": "workspace:*",
    "@infinity-agent/cordis": "workspace:~"
  },
  "dependencies": {
    "@infinity-agent/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@infinity-agent/agent": "workspace:*",
    "@infinity-agent/credentials": "workspace:*",
    "@infinity-agent/credentials-local": "workspace:*",
    "@infinity-agent/deepseek-account": "workspace:*",
    "@infinity-agent/launch-environment": "workspace:*",
    "@infinity-agent/llm-deepseek": "workspace:*",
    "@infinity-agent/session": "workspace:*",
    "@infinity-agent/web": "workspace:*",
    "@infinity-agent/cordis": "workspace:~",
    "@infinity-agent/http-proxy": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@infinity-agent/deepseek-account": {
      "optional": true
    }
  }
}
