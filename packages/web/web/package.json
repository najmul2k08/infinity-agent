{
  "name": "@infinity-agent/web",
  "description": "Abstract web access capability seam (ctx.web) for the Infinity agent — search/fetch provider registry, registration-order-independent selection, request/result vocabulary, and the WebError taxonomy",
  "version": "0.2.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/najmul2k08/infinity-agent.git",
    "directory": "packages/web/web"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@infinity-agent/llm": "workspace:*",
    "@infinity-agent/cordis": "workspace:~"
  },
  "dependencies": {
    "@infinity-agent/package-manifest": "workspace:*",
    "@infinity-agent/schemastery": "workspace:~",
    "@infinity-agent/typert-protocol": "workspace:*"
  },
  "devDependencies": {
    "@infinity-agent/llm": "workspace:*",
    "@infinity-agent/cordis": "workspace:~"
  }
}
